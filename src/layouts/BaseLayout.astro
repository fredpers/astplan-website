---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { APP_URL } from '../config/brand';

interface Props { title: string; description?: string }
const {
  title,
  description = 'RamosMap – Feld-Baumkontrolle. Schnell, klar, exportfertig. Export in euer Kataster.',
} = Astro.props;
const fullTitle = title.includes('RamosMap') ? title : `${title} · RamosMap`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL('/apple-touch-icon.png', Astro.site).href : '/apple-touch-icon.png';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#051023" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="RamosMap" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <div class="sticky-cta" data-theme="dark">
      <a class="btn btn-accent" href={APP_URL} rel="noopener">App öffnen</a>
    </div>
  </body>
</html>
