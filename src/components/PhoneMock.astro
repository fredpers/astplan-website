---
// Illustrative app mockup (pure CSS/SVG, our own drawing). No real data.
---
<div class="phone" aria-hidden="true">
  <div class="screen">
    <div class="topbar">
      <span class="tb-title"></span>
      <span class="tb-chip">Filter</span>
    </div>
    <svg class="map" viewBox="0 0 260 330" preserveAspectRatio="xMidYMid slice">
      <rect width="260" height="330" fill="var(--rm-ink-100)" />
      <path d="M-10 210 C 60 190, 120 230, 270 170" stroke="var(--rm-ink-0)" stroke-width="14" fill="none" />
      <path d="M150 -10 C 140 80, 175 150, 160 340" stroke="var(--rm-ink-0)" stroke-width="10" fill="none" />
      <g fill="none" stroke="var(--rm-purple-200)" stroke-width="2" stroke-linejoin="round">
        <path d="M14 30 L84 18 L120 70 L60 104 L10 86 Z" />
        <path d="M120 70 L178 52 L236 88 L196 140 L130 128 Z" />
        <path d="M10 120 L60 104 L130 128 L118 186 L30 182 Z" />
        <path d="M30 240 L110 226 L132 300 L40 316 Z" />
        <path d="M176 222 L250 206 L256 290 L188 300 Z" />
      </g>
      <g fill="var(--rm-tree-unassessed)" stroke="var(--rm-ink-0)" stroke-width="2">
        <circle cx="40" cy="58" r="5" fill="var(--rm-tree-good)" /><circle cx="78" cy="72" r="5" /><circle cx="160" cy="96" r="5" fill="var(--rm-tree-good)" />
        <circle cx="202" cy="108" r="5" /><circle cx="56" cy="150" r="5" /><circle cx="96" cy="160" r="5" fill="var(--rm-tree-moderate)" />
        <circle cx="74" cy="270" r="5" /><circle cx="214" cy="256" r="5" fill="var(--rm-tree-slight)" /><circle cx="226" cy="74" r="5" />
      </g>
      <g>
        <circle cx="128" cy="150" r="22" fill="var(--rm-brand)" opacity="0.14" />
        <circle cx="128" cy="150" r="11" fill="none" stroke="var(--rm-brand)" stroke-width="3.5" />
        <circle cx="128" cy="150" r="4" fill="var(--rm-brand)" />
      </g>
    </svg>
    <div class="sheet">
      <span class="handle"></span>
      <span class="sk sk-title"></span>
      <span class="sk sk-line"></span>
      <div class="chips"><span class="chip on">Status</span><span class="chip">Maßnahme</span></div>
      <span class="sheet-btn">Speichern</span>
    </div>
  </div>
</div>
<style>
  .phone {
    width: 280px; height: 572px; padding: 9px;
    border-radius: 44px;
    background: var(--site-frame);
    border: 1px solid var(--site-line-strong);
    box-shadow: var(--rm-shadow-glow-dark);
    position: relative;
  }
  .screen {
    position: relative; height: 100%; overflow: hidden;
    border-radius: 36px; background: var(--rm-ink-25);
    display: flex; flex-direction: column;
  }
  .topbar { display: flex; align-items: center; justify-content: space-between; padding: 26px 18px 12px; background: var(--rm-ink-0); }
  .tb-title { width: 96px; height: 12px; border-radius: 6px; background: var(--rm-ink-900); }
  .tb-chip { font: var(--rm-type-caption); font-weight: 600; color: var(--rm-purple-800); background: var(--rm-purple-100); border-radius: var(--rm-radius-pill); padding: 4px 10px; }
  .map { flex: 1; width: 100%; height: auto; }
  .sheet {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: var(--rm-ink-0); border-radius: var(--rm-radius-2xl) var(--rm-radius-2xl) 0 0;
    padding: 10px 18px 20px; box-shadow: var(--rm-shadow-sheet);
    display: flex; flex-direction: column; gap: 10px;
  }
  .handle { width: 36px; height: 4px; border-radius: 2px; background: var(--rm-ink-200); align-self: center; margin-bottom: 4px; }
  .sk { display: block; height: 9px; border-radius: 5px; background: var(--rm-ink-100); }
  .sk-title { width: 58%; height: 12px; background: var(--rm-ink-900); }
  .sk-line { width: 82%; }
  .chips { display: flex; gap: 6px; margin-top: 2px; }
  .chip { font: var(--rm-type-caption); font-weight: 600; color: var(--rm-ink-900); border: 1px solid var(--rm-ink-200); border-radius: var(--rm-radius-pill); padding: 5px 11px; }
  .chip.on { background: var(--rm-brand); border-color: var(--rm-brand); color: var(--rm-ink-0); }
  .sheet-btn { margin-top: 4px; text-align: center; font: 600 13px/1 var(--rm-font-ui); color: var(--rm-ink-0); background: var(--rm-brand); border-radius: var(--rm-radius-pill); padding: 12px; }
</style>
