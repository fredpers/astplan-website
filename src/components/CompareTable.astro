---
interface Row {
  label: string;
  ramosmap: string;
  kataster: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<div class="table-wrap" role="region" aria-label="Vergleichstabelle" tabindex="0">
  <table class="compare">
    <thead>
      <tr>
        <th scope="col">Aspekt</th>
        <th scope="col" class="hl">RamosMap</th>
        <th scope="col">Baumkataster / GIS</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td class="hl">{row.ramosmap}</td>
            <td>{row.kataster}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto; max-width: 920px; margin: 0 auto;
    border: 1px solid var(--rm-border); border-radius: var(--rm-radius-xl);
    background: var(--rm-surface); box-shadow: var(--rm-shadow-md);
  }
  .compare { width: 100%; border-collapse: collapse; min-width: 560px; font: var(--rm-type-body); }
  th, td { padding: 18px 22px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rm-divider); color: var(--rm-text-secondary); }
  thead th { font: var(--rm-type-overline); letter-spacing: var(--rm-type-overline-tracking); text-transform: uppercase; color: var(--rm-text-muted); background: var(--rm-surface-alt); }
  tbody th { font-weight: 600; color: var(--rm-text-primary); width: 22%; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: none; }
  .hl { background: var(--rm-brand-subtle); color: var(--rm-text-primary); font-weight: 500; }
  thead th.hl { color: var(--rm-brand-strong); background: var(--rm-brand-muted); }
</style>
