---
import Brand from './Brand.astro';
import CtaButtons from './CtaButtons.astro';
const nav = [
  { href: '/produkt', label: 'Produkt' },
  { href: '/einordnung', label: 'Einordnung' },
  { href: '/preise', label: 'Preise' },
  { href: '/faq', label: 'FAQ' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header" data-theme="dark">
  <div class="container header-inner">
    <Brand size={32} />
    <nav class="nav" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a href={item.href} class="nav-link" aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <CtaButtons size="sm" variant="outline" />
    </div>
    <button type="button" class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-panel" id="menu-toggle">
      <span></span><span></span>
    </button>
  </div>
  <div class="mobile-panel" id="mobile-panel" hidden>
    <nav class="container" aria-label="Mobilnavigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <div class="mobile-ctas"><CtaButtons variant="accent" /></div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    background: var(--site-header-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--rm-divider);
  }
  .header-inner { display: flex; align-items: center; gap: var(--rm-space-8); height: var(--site-header-h); }
  .nav { display: none; gap: var(--rm-space-1); }
  .nav-link {
    padding: 8px 12px; border-radius: var(--rm-radius-pill);
    font: var(--rm-type-body-sm); color: var(--rm-text-secondary);
    text-decoration: none !important;
    transition: color .2s ease, background .2s ease;
  }
  .nav-link:hover { color: var(--rm-text-primary); background: var(--rm-surface-alt); }
  .nav-link[aria-current='page'] { color: var(--rm-text-primary); background: var(--site-pill-bg); }
  .header-actions { display: none; margin-left: auto; }
  .menu-toggle {
    margin-left: auto; width: 44px; height: 44px;
    border: 1px solid var(--site-line-strong); border-radius: var(--rm-radius-pill);
    background: transparent; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 6px; cursor: pointer;
  }
  .menu-toggle span { display: block; width: 18px; height: 1.5px; background: var(--rm-text-primary); border-radius: 1px; transition: transform .2s ease; }
  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .mobile-panel { border-top: 1px solid var(--rm-divider); padding: var(--rm-space-3) 0 var(--rm-space-6); background: var(--rm-bg); }
  .mobile-panel nav { display: flex; flex-direction: column; gap: var(--rm-space-1); }
  .mobile-panel a:not(.btn) {
    padding: 12px 4px; color: var(--rm-text-primary);
    font: 500 18px/1.4 var(--rm-font-display); border-bottom: 1px solid var(--rm-divider);
    text-decoration: none !important;
  }
  .mobile-ctas { margin-top: var(--rm-space-4); }
  @media (min-width: 920px) {
    .nav, .header-actions { display: flex; }
    .menu-toggle, .mobile-panel { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-panel');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
    if (open) panel?.setAttribute('hidden', ''); else panel?.removeAttribute('hidden');
  });
</script>
