---
import Brand from './Brand.astro';
import CtaButtons from './CtaButtons.astro';
const nav = [
  { href: '/produkt', label: 'Produkt' },
  { href: '/einordnung', label: 'Einordnung' },
  { href: '/preise', label: 'Preise' },
  { href: '/faq', label: 'FAQ' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header" data-theme="dark">
  <div class="container header-inner">
    <Brand size={32} />
    <nav class="nav" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a href={item.href} class="nav-link" aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <CtaButtons size="sm" variant="accent" showRegister={false} />
    </div>
    <button type="button" class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-panel" id="menu-toggle">
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
      <span class="x" aria-hidden="true">×</span>
    </button>
  </div>
  <div class="menu-backdrop" id="menu-backdrop" hidden></div>
  <div class="mobile-panel" id="mobile-panel" hidden>
    <div class="container mobile-inner">
      <div class="mobile-head">
        <span class="mobile-title">Menü</span>
        <button type="button" class="menu-close" id="menu-close" aria-label="Menü schließen">
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <nav aria-label="Mobilnavigation">
        {nav.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="mobile-ctas"><CtaButtons variant="accent" /></div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    background: #051023;
    border-bottom: 1px solid var(--rm-divider);
  }
  .header-inner { display: flex; align-items: center; gap: var(--rm-space-8); height: var(--site-header-h); }
  .nav { display: none; gap: var(--rm-space-1); }
  .nav-link {
    padding: 8px 12px; border-radius: var(--rm-radius-pill);
    font: var(--rm-type-body-sm); color: var(--rm-text-secondary);
    text-decoration: none !important;
    transition: color .2s ease, background .2s ease;
  }
  .nav-link:hover { color: var(--rm-text-primary); background: var(--rm-surface-alt); }
  .nav-link[aria-current='page'] { color: var(--rm-text-primary); background: var(--site-pill-bg); }
  .header-actions { display: none; margin-left: auto; }
  .menu-toggle {
    margin-left: auto; width: 44px; height: 44px;
    border: 1px solid var(--site-line-strong); border-radius: var(--rm-radius-pill);
    background: transparent; display: grid; place-items: center; cursor: pointer;
    color: var(--rm-text-primary);
  }
  .menu-toggle .bars { display: flex; flex-direction: column; gap: 6px; }
  .menu-toggle .bars span { display: block; width: 18px; height: 1.5px; background: var(--rm-text-primary); border-radius: 1px; }
  .menu-toggle .x { display: none; font: 500 28px/1 var(--rm-font-ui); }
  .menu-toggle[aria-expanded='true'] .bars { display: none; }
  .menu-toggle[aria-expanded='true'] .x { display: block; }
  .menu-backdrop {
    position: fixed; inset: 0; z-index: 98;
    background: rgba(5, 16, 35, 0.62);
  }
  .mobile-panel {
    position: fixed; inset: 0; z-index: 99;
    background: #051023;
    overflow-y: auto;
    padding: calc(var(--site-header-h) + var(--rm-space-4)) 0 var(--rm-space-10);
  }
  .mobile-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: var(--rm-space-4);
  }
  .mobile-title { font: var(--rm-type-overline); letter-spacing: var(--rm-type-overline-tracking); text-transform: uppercase; color: var(--rm-brand-text); }
  .menu-close {
    width: 44px; height: 44px; border: 1px solid var(--site-line-strong);
    border-radius: var(--rm-radius-pill); background: transparent;
    color: var(--rm-text-primary); cursor: pointer;
    display: grid; place-items: center;
  }
  .menu-close span { font: 500 28px/1 var(--rm-font-ui); }
  .mobile-panel nav { display: flex; flex-direction: column; gap: var(--rm-space-1); }
  .mobile-panel a:not(.btn) {
    min-height: 44px; display: flex; align-items: center;
    padding: 12px 4px; color: var(--rm-text-primary);
    font: 500 18px/1.4 var(--rm-font-display); border-bottom: 1px solid var(--rm-divider);
    text-decoration: none !important;
  }
  .mobile-ctas { margin-top: var(--rm-space-6); }
  @media (min-width: 920px) {
    .nav, .header-actions { display: flex; }
    .menu-toggle, .mobile-panel, .menu-backdrop { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const panel = document.getElementById('mobile-panel');
  const backdrop = document.getElementById('menu-backdrop');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    if (open) {
      panel?.removeAttribute('hidden');
      backdrop?.removeAttribute('hidden');
      document.body.classList.add('menu-open');
    } else {
      panel?.setAttribute('hidden', '');
      backdrop?.setAttribute('hidden', '');
      document.body.classList.remove('menu-open');
    }
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  closeBtn?.addEventListener('click', () => setOpen(false));
  backdrop?.addEventListener('click', () => setOpen(false));
</script>
