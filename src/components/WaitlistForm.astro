---
---

<div class="waitlist" id="waitlist-root">
  <form class="form" id="waitlist-form" novalidate>
    <div class="field">
      <label for="email">E-Mail <span class="req">*</span></label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="name@firma.de"
      />
    </div>
    <div class="field">
      <label for="name">Name <span class="opt">optional</span></label>
      <input type="text" id="name" name="name" autocomplete="name" placeholder="Vor- und Nachname" />
    </div>
    <div class="field">
      <label for="firma">Firma <span class="opt">optional</span></label>
      <input type="text" id="firma" name="firma" autocomplete="organization" placeholder="Organisation" />
    </div>
    <div class="field">
      <label for="nutze">Ich nutze bereits</label>
      <select id="nutze" name="nutze">
        <option value="">Bitte wählen…</option>
        <option value="green-gis">Green GIS</option>
        <option value="treesta">Treesta</option>
        <option value="anderes">anderes</option>
        <option value="noch-keines">noch keines</option>
      </select>
    </div>
    <!-- Honeypot: must stay empty; hidden from users, not autocomplete -->
    <div class="hp" aria-hidden="true">
      <label for="website">Website</label>
      <input
        type="text"
        id="website"
        name="website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <p class="form-error" id="waitlist-error" hidden role="alert"></p>
    <button type="submit" class="btn btn-primary submit" id="waitlist-submit">Auf die Liste</button>
  </form>
  <div class="success card-soft" id="waitlist-success" hidden>
    <h3>Danke — wir melden uns.</h3>
    <p>
      Ihr seid auf der Warteliste. Wir melden uns per E-Mail, sobald der nächste Zugang frei wird. Bis dahin
      könnt ihr die App bereits unter
      <a href="https://astplanapp.web.app" rel="noopener">astplanapp.web.app</a> öffnen.
    </p>
  </div>
</div>

<style>
  .form {
    display: grid;
    gap: 18px;
    max-width: 480px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  label {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-primary);
  }
  .req {
    color: var(--brand-purple);
  }
  .opt {
    font-weight: 400;
    color: var(--ink-secondary);
    font-size: 13px;
  }
  input,
  select {
    min-height: 48px;
    padding: 0 14px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 16px;
    color: var(--ink-primary);
    background: var(--surface);
  }
  input:focus,
  select:focus {
    outline: 2px solid var(--brand-purple);
    outline-offset: 1px;
    border-color: var(--brand-purple);
  }
  .hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-error {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: #b42318;
  }
  .submit {
    width: 100%;
    max-width: 280px;
  }
  .submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }
  .success {
    max-width: 520px;
    padding: 28px;
    border-radius: var(--radius);
  }
  .success h3 {
    margin-bottom: 8px;
  }
  .success p {
    margin: 0;
  }
</style>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('waitlist-success');
  const errorEl = document.getElementById('waitlist-error');
  const submitBtn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.hidden = true;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const emailInput = form.querySelector('#email') as HTMLInputElement | null;
    const email = emailInput?.value?.trim() ?? '';
    if (!email || !email.includes('@')) {
      emailInput?.focus();
      showError('Bitte eine gültige E-Mail angeben.');
      return;
    }

    const payload = {
      email,
      name: (form.querySelector('#name') as HTMLInputElement)?.value?.trim() ?? '',
      firma: (form.querySelector('#firma') as HTMLInputElement)?.value?.trim() ?? '',
      nutze: (form.querySelector('#nutze') as HTMLSelectElement)?.value ?? '',
      website: (form.querySelector('#website') as HTMLInputElement)?.value ?? '',
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet…';
    }

    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });

      let body: { ok?: boolean; error?: string } = {};
      try {
        body = await res.json();
      } catch {
        body = {};
      }

      if (res.ok && body.ok) {
        form.hidden = true;
        success?.removeAttribute('hidden');
        return;
      }

      showError(body.error || 'Senden fehlgeschlagen. Bitte später erneut versuchen.');
    } catch {
      showError('Netzwerkfehler. Bitte Verbindung prüfen und erneut versuchen.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Auf die Liste';
      }
    }
  });
</script>
