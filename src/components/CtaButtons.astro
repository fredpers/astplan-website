---
// Primary "App öffnen" + disabled "Registrieren · bald verfügbar" (visible, aria-disabled, not clickable;
// muted dashed outline — never line-through, never filled).
import Chevron from './Chevron.astro';
import { APP_URL } from '../config/brand';
interface Props { size?: 'sm' | 'md'; variant?: 'primary' | 'accent' | 'outline' | 'secondary'; showRegister?: boolean; align?: 'start' | 'center' }
const { size = 'md', variant = 'primary', showRegister = true, align = 'start' } = Astro.props;
---
<div class:list={['cta-row', `align-${align}`]}>
  <a class:list={['btn', `btn-${variant}`, { 'btn-sm': size === 'sm' }]} href={APP_URL} rel="noopener">
    App öffnen <Chevron />
  </a>
  {showRegister && (
    <span class:list={['btn', 'btn-disabled', { 'btn-sm': size === 'sm' }]} role="link" aria-disabled="true" title="Registrierung ist bald verfügbar">
      Registrieren<span class="soon-badge"><span aria-hidden="true">·</span> bald verfügbar</span>
    </span>
  )}
</div>
<style>
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--rm-space-2) var(--rm-space-3); }
  .align-center { justify-content: center; }
</style>
