---
// Primary: start the 7-day trial in the app. Secondary: outlined contact mailto.
// Cobalt filled: light cobalt on dark sections (variant="accent"), cobalt on light (variant="primary").
import Chevron from './Chevron.astro';
import { TRIAL_CTA, TRIAL_URL, CONTACT_CTA, CONTACT_MAILTO } from '../config/brand';
interface Props { size?: 'sm' | 'md'; variant?: 'primary' | 'accent'; showAppLink?: boolean; align?: 'start' | 'center' }
const { size = 'md', variant = 'primary', showAppLink = true, align = 'start' } = Astro.props;
---
<div class:list={['cta-row', `align-${align}`]}>
  <a class:list={['btn', `btn-${variant}`, { 'btn-sm': size === 'sm' }]} href={TRIAL_URL} rel="noopener">
    {TRIAL_CTA} <Chevron />
  </a>
  {showAppLink && (
    <a class:list={['btn', 'btn-outline', { 'btn-sm': size === 'sm' }]} href={CONTACT_MAILTO}>
      {CONTACT_CTA}
    </a>
  )}
</div>
<style>
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--rm-space-2) var(--rm-space-4); }
  .align-center { justify-content: center; }
</style>
