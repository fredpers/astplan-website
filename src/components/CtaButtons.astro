---
// Primary: access request (mailto). Secondary: outlined "App öffnen" for invited testers.
// Lime filled on dark sections (variant="accent"); purple filled on light (variant="primary").
import Chevron from './Chevron.astro';
import { ACCESS_CTA, ACCESS_MAILTO, APP_CTA, APP_URL } from '../config/brand';
interface Props { size?: 'sm' | 'md'; variant?: 'primary' | 'accent'; showAppLink?: boolean; align?: 'start' | 'center' }
const { size = 'md', variant = 'primary', showAppLink = true, align = 'start' } = Astro.props;
---
<div class:list={['cta-row', `align-${align}`]}>
  <a class:list={['btn', `btn-${variant}`, { 'btn-sm': size === 'sm' }]} href={ACCESS_MAILTO}>
    {ACCESS_CTA} <Chevron />
  </a>
  {showAppLink && (
    <a class:list={['btn', 'btn-outline', { 'btn-sm': size === 'sm' }]} href={APP_URL} rel="noopener">
      {APP_CTA}
    </a>
  )}
</div>
<style>
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--rm-space-2) var(--rm-space-4); }
  .align-center { justify-content: center; }
</style>
