---
import Brand from './Brand.astro';
import { APP_URL } from '../config/brand';
---
<footer class="site-footer" data-theme="dark">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Brand size={28} />
      <p>Feld-Baumkontrolle – Export in Ihr Kataster.</p>
    </div>
    <nav class="footer-nav" aria-label="Fußzeile">
      <a href="/produkt">Produkt</a>
      <a href="/faq">FAQ</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href={APP_URL} rel="noopener">App</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--rm-divider); padding: var(--rm-space-10) 0; }
  .footer-inner { display: flex; flex-direction: column; gap: var(--rm-space-6); }
  .footer-brand p { margin: var(--rm-space-3) 0 0; font: var(--rm-type-body-sm); color: var(--rm-text-muted); }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 0 var(--rm-space-4); }
  .footer-nav a {
    font: var(--rm-type-body-sm); color: var(--rm-link);
    min-height: 44px; display: inline-flex; align-items: center; padding: 10px 4px;
  }
  .footer-nav a:hover { color: var(--rm-text-primary); }
  @media (min-width: 760px) {
    .footer-inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
