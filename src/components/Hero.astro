---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  showPhone?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  showPhone = false,
} = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {subtitle && <p class="lead">{subtitle}</p>}
      <div class="hero-ctas">
        <a class="btn btn-primary" href="https://astplanapp.web.app" rel="noopener">App öffnen</a>
        <span
          class="btn btn-disabled"
          role="link"
          aria-disabled="true"
          title="Registrieren — demnächst"
        >
          Registrieren
        </span>
      </div>
    </div>
    {
      showPhone && (
        <div class="hero-visual" aria-hidden="true">
          <div class="phone">
            <div class="phone-notch" />
            <div class="phone-screen">
              <div class="mock-map">
                <div class="mock-roads" />
                <span class="pin p1" />
                <span class="pin p2" />
                <span class="pin p3" />
                <span class="pin active" />
              </div>
              <div class="mock-sheet">
                <div class="sheet-handle" />
                <div class="sheet-title" />
                <div class="sheet-row" />
                <div class="sheet-row short" />
                <div class="sheet-chip" />
              </div>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding: 40px 0 24px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--page) 100%);
  }
  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .hero-copy h1 {
    margin-bottom: 16px;
  }
  .lead {
    font-size: 18px;
    line-height: 28px;
    max-width: 480px;
    margin-bottom: 28px;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .phone {
    width: 240px;
    height: 480px;
    background: var(--ink-primary);
    border-radius: 32px;
    padding: 10px;
    box-shadow: 0 24px 48px rgba(14, 15, 20, 0.18);
    position: relative;
  }
  .phone-notch {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 8px;
    background: #2a2b33;
    border-radius: 4px;
    z-index: 2;
  }
  .phone-screen {
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    background: #d8e4d4;
    position: relative;
  }
  .mock-map {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 40%, #c5d9bf 0%, transparent 40%),
      radial-gradient(circle at 70% 60%, #b8ceb0 0%, transparent 35%),
      linear-gradient(135deg, #cfe0c8 0%, #b9cfb2 100%);
  }
  .mock-roads::before,
  .mock-roads::after {
    content: '';
    position: absolute;
    background: rgba(255, 255, 255, 0.45);
  }
  .mock-roads::before {
    top: 35%;
    left: -10%;
    width: 120%;
    height: 10px;
    transform: rotate(-8deg);
  }
  .mock-roads::after {
    top: -10%;
    left: 55%;
    width: 10px;
    height: 120%;
    transform: rotate(12deg);
  }
  .pin {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: #8a8f9e;
  }
  .pin.p1 { top: 28%; left: 22%; }
  .pin.p2 { top: 48%; left: 62%; }
  .pin.p3 { top: 62%; left: 38%; }
  .pin.active {
    top: 40%;
    left: 48%;
    width: 18px;
    height: 18px;
    background: var(--brand-purple);
    box-shadow: 0 0 0 6px rgba(107, 78, 255, 0.25);
  }
  .mock-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background: var(--surface);
    border-radius: 18px 18px 0 0;
    padding: 12px 16px 16px;
    box-shadow: 0 -8px 24px rgba(14, 15, 20, 0.08);
  }
  .sheet-handle {
    width: 36px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    margin: 0 auto 14px;
  }
  .sheet-title {
    height: 12px;
    width: 55%;
    background: var(--ink-primary);
    border-radius: 4px;
    margin-bottom: 14px;
    opacity: 0.85;
  }
  .sheet-row {
    height: 8px;
    width: 80%;
    background: var(--border);
    border-radius: 4px;
    margin-bottom: 10px;
  }
  .sheet-row.short {
    width: 50%;
  }
  .sheet-chip {
    margin-top: 8px;
    height: 28px;
    width: 96px;
    background: var(--brand-purple-soft);
    border-radius: 8px;
  }
  @media (min-width: 860px) {
    .hero {
      padding: 56px 0 32px;
    }
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
    }
    .phone {
      width: 260px;
      height: 520px;
    }
  }
</style>
