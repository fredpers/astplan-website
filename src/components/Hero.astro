---
import CtaButtons from './CtaButtons.astro';
interface Props { eyebrow?: string; title: string; subtitle?: string; floats?: { label: string; text: string }[] }
const { eyebrow, title, subtitle, floats = [] } = Astro.props;
---
<section class="hero" data-theme="dark">
  <div class="glow g1"></div>
  <div class="glow g2"></div>
  <div class="glow g3"></div>
  <div class="stars"></div>
  <div class="container hero-grid rel">
    <div class="hero-copy">
      {eyebrow && <span class="pill">{eyebrow}</span>}
      <h1 set:html={title} />
      {subtitle && <p class="lead">{subtitle}</p>}
      <CtaButtons variant="accent" />
    </div>
    {floats.length > 0 && (
      <div class="hero-visual">
        <div class="halo" aria-hidden="true"></div>
        <ul class="float-stack">
          {floats.map((f) => (
            <li class="float">
              <span class="float-label">{f.label}</span>
              <span class="float-text">{f.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding: calc(var(--site-header-h) + clamp(48px, 7vw, 96px)) 0 clamp(80px, 9vw, 128px);
  }
  .g1 { width: 420px; height: 640px; left: -300px; top: 120px; background: var(--site-glow-c); transform: rotate(18deg); }
  .g2 { width: 460px; height: 600px; right: -320px; top: 60px; background: var(--site-glow-a); }
  .g3 { width: 760px; height: 560px; left: 50%; top: 14%; transform: translateX(-12%); background: var(--site-glow-b); opacity: .55; filter: blur(130px); }
  .hero-grid { display: grid; gap: var(--rm-space-14); align-items: center; }
  .hero-copy h1 {
    font: var(--rm-type-display);
    font-size: var(--site-fs-hero);
    letter-spacing: var(--rm-type-display-tracking);
    margin-bottom: var(--rm-space-6);
  }
  .lead { color: var(--rm-text-secondary); max-width: 540px; margin-bottom: var(--rm-space-8); }
  .hero-visual { position: relative; display: flex; justify-content: center; }
  .halo {
    position: absolute; left: 50%; top: 50%; width: 520px; height: 520px; transform: translate(-50%, -50%);
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 54%, var(--site-pill-border) 55%, transparent 56%),
      radial-gradient(circle, transparent 68%, var(--rm-border) 69%, transparent 70%);
    pointer-events: none;
  }
  .float-stack {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--rm-space-4);
    width: 100%; max-width: 360px;
    position: relative;
  }
  .float {
    display: flex; flex-direction: column; gap: 2px;
    padding: 16px 18px;
    background: var(--site-glass);
    border: 1px solid var(--site-pill-border);
    border-radius: var(--rm-radius-lg);
    backdrop-filter: blur(10px);
    box-shadow: var(--rm-shadow-inset-glow-dark);
  }
  .float-label { font: var(--rm-type-overline); letter-spacing: var(--rm-type-overline-tracking); text-transform: uppercase; color: var(--rm-brand-text); }
  .float-text { font: var(--rm-type-body-sm); color: var(--rm-text-primary); }
  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: 1.08fr 0.92fr; gap: var(--rm-space-8); }
  }
  @media (max-width: 979px) {
    .hero-visual { display: none; }
  }
</style>
