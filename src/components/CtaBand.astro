---
import CtaButtons from './CtaButtons.astro';
import { LOGO_SRC_SMALL } from '../config/brand';
import { CTA_SUPPORT_HTML } from '../config/copy';
interface Props { title?: string; body?: string; showAppLink?: boolean }
const {
  title = 'Zugang zur geschlossenen <span class="hl">Testphase</span>',
  body = 'RamosMap befindet sich in einer geschlossenen Testphase. Fragen Sie den Zugang an, wenn Sie die App prüfen möchten.',
  showAppLink = true,
} = Astro.props;
---
<section class="section cta-section">
  <div class="container">
    <div class="panel" data-theme="dark">
      <div class="glow pg1"></div>
      <div class="glow pg2"></div>
      <div class="stars"></div>
      <div class="inner rel">
        <img class="mark" src={LOGO_SRC_SMALL} width="64" height="64" alt="" decoding="async" />
        <h2 set:html={title} />
        <p>{body}</p>
        <CtaButtons align="center" variant="accent" showAppLink={showAppLink} />
        <p class="cta-support" set:html={CTA_SUPPORT_HTML} />
      </div>
    </div>
  </div>
</section>
<style>
  .cta-section { padding-top: var(--site-section-y); }
  .panel {
    position: relative; overflow: hidden; isolation: isolate;
    border: 1px solid var(--rm-border);
    border-radius: var(--rm-radius-2xl);
    background: var(--rm-bg);
    padding: clamp(56px, 8vw, 112px) var(--rm-space-6);
    text-align: center;
  }
  .pg1 { width: 380px; height: 420px; left: -160px; bottom: -180px; background: var(--site-glow-c); }
  .pg2 { width: 360px; height: 380px; right: -140px; top: -150px; background: var(--site-glow-a); }
  .mark { width: 64px; height: 64px; margin: 0 auto var(--rm-space-8); filter: drop-shadow(0 10px 30px var(--site-glow-a)); }
  h2 { max-width: 760px; margin: 0 auto var(--rm-space-4); }
  p { font: var(--rm-type-body-lg); color: var(--rm-text-secondary); max-width: 560px; margin: 0 auto var(--rm-space-8); }
  .cta-support { font: var(--rm-type-body-sm); color: var(--rm-text-muted); margin: var(--rm-space-6) auto 0; }
</style>
