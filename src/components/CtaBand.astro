---
interface Props {
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  showDisabledRegister?: boolean;
}

const {
  title = 'Bereit für Feld-Tempo?',
  body = 'App öffnen und direkt im Feld starten — Registrierung folgt demnächst.',
  primaryHref = 'https://astplanapp.web.app',
  primaryLabel = 'App öffnen',
  showDisabledRegister = true,
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="band card-soft">
      <div>
        <h2>{title}</h2>
        <p>{body}</p>
      </div>
      <div class="band-actions">
        <a class="btn btn-primary" href={primaryHref} rel="noopener">{primaryLabel}</a>
        {
          showDisabledRegister && (
            <span
              class="btn btn-disabled"
              role="link"
              aria-disabled="true"
              title="Registrieren — demnächst"
            >
              Registrieren
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px 28px;
    border-radius: var(--radius);
  }
  .band h2 {
    margin-bottom: 8px;
  }
  .band p {
    margin: 0;
    max-width: 480px;
  }
  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 40px 36px;
    }
  }
</style>
