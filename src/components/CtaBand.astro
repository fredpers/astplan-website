---
interface Props {
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title = 'Bereit für Feld-Tempo?',
  body = 'Auf die Warteliste — wir melden uns, sobald der nächste Zugang frei wird.',
  primaryHref = '/warteliste',
  primaryLabel = 'Auf die Warteliste',
  secondaryHref = 'https://astplanapp.web.app',
  secondaryLabel = 'App öffnen',
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="band card-soft">
      <div>
        <h2>{title}</h2>
        <p>{body}</p>
      </div>
      <div class="band-actions">
        <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
        {
          secondaryHref && (
            <a class="btn btn-ghost" href={secondaryHref} rel="noopener">
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px 28px;
    border-radius: var(--radius);
  }
  .band h2 {
    margin-bottom: 8px;
  }
  .band p {
    margin: 0;
    max-width: 480px;
  }
  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 40px 36px;
    }
  }
</style>
