---
interface Card {
  title: string;
  body: string;
}

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cards">
      {
        cards.map((card) => (
          <article class="card feature-card">
            <div class="icon" aria-hidden="true" />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 16px;
  }
  .feature-card h3 {
    margin-bottom: 8px;
  }
  .feature-card p {
    margin: 0;
    font-size: 16px;
    line-height: 26px;
  }
  .icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--brand-purple-soft);
    margin-bottom: 16px;
    position: relative;
  }
  .icon::after {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: 6px;
    background: var(--brand-purple);
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }
</style>
