---
interface Step {
  n: string;
  title: string;
  body: string;
}

interface Props {
  title?: string;
  steps: Step[];
}

const { title = 'So läuft der Tag', steps } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>{title}</h2>
    </div>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="card step">
            <span class="num">{step.n}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .step {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--brand-purple);
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step h3 {
    margin-bottom: 6px;
  }
  .step p {
    margin: 0;
    font-size: 16px;
    line-height: 26px;
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
