---
interface Props {
  title: string;
  kind?: 'impressum' | 'datenschutz';
}

const { title, kind = 'impressum' } = Astro.props;
---

<article class="legal card">
  <span class="badge">Platzhalter</span>
  <h1>{title}</h1>
  {
    kind === 'impressum' ? (
      <div class="body">
        <p>
          Dieses Impressum ist ein <strong>Platzhalter</strong> für RamosMap. Verbindliche
          Anbieterkennzeichnung folgt mit Domain und Firmendaten (AST-87) — hier werden keine erfundenen
          Firmendaten, Adressen oder Registerangaben eingesetzt.
        </p>
        <p class="muted">
          Bis zur finalen Fassung: rechtlich maßgebliche Angaben erscheinen hier, sobald sie freigegeben
          sind. Die Domain ramosmap.com ist ausstehend (AST-87); Custom-DNS ist nicht Teil dieses Cutover.
        </p>
      </div>
    ) : (
      <div class="body">
        <p>
          Diese Datenschutzerklärung ist ein <strong>Platzhalter</strong> für RamosMap (DE/EU, DSGVO).
          Die finale Fassung folgt mit AST-87 / AST-76 — ohne erfundene Verarbeitungszwecke oder
          Auftragsverarbeiter.
        </p>
        <p class="muted">
          Bis dahin: personenbezogene Daten werden erst angebunden, wenn die Privacy-Texte und die
          zugehörigen Verarbeitungen freigegeben sind.
        </p>
      </div>
    )
  }
</article>

<style>
  .legal {
    max-width: 640px;
    padding: 32px;
  }
  .badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brand-purple);
    background: var(--brand-purple-soft);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .body p {
    margin-bottom: 1em;
  }
  .muted {
    color: var(--ink-secondary);
  }
</style>
