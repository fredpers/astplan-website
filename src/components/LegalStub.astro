---
interface Props {
  title: string;
  kind?: 'impressum' | 'datenschutz';
}

const { title, kind = 'impressum' } = Astro.props;
---

<article class="legal card">
  <span class="pill">Platzhalter</span>
  <h1>{title}</h1>
  {
    kind === 'impressum' ? (
      <div class="body">
        <p>
          Dieses Impressum ist ein <strong>Platzhalter</strong>. Verbindliche Anbieterkennzeichnung folgt
          — hier werden keine erfundenen Firmendaten, Adressen oder Registerangaben eingesetzt.
        </p>
        <p class="muted">
          Bis zur finalen Fassung: rechtlich maßgebliche Angaben erscheinen hier, sobald sie freigegeben
          sind.
        </p>
      </div>
    ) : (
      <div class="body">
        <p>
          Diese Datenschutzerklärung ist ein <strong>Platzhalter</strong> für DE/EU-Anforderungen
          (DSGVO). Die finale Fassung folgt — ohne erfundene Verarbeitungszwecke oder
          Auftragsverarbeiter.
        </p>
        <p class="muted">
          Bis dahin: personenbezogene Daten werden erst angebunden, wenn die Privacy-Texte
          und die zugehörigen Verarbeitungen freigegeben sind.
        </p>
      </div>
    )
  }
</article>

<style>
  .legal { max-width: 720px; margin: 0 auto; padding: var(--rm-space-10); }
  .legal h1 { margin-bottom: var(--rm-space-6); }
  .body p { margin-bottom: 1em; color: var(--rm-text-secondary); }
  .body p.muted { color: var(--rm-text-muted); }
</style>
