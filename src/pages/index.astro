---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import StepRow from '../components/StepRow.astro';
import PositionTeaser from '../components/PositionTeaser.astro';
import CtaBand from '../components/CtaBand.astro';

const cards = [
  { icon: 'map', title: 'Karte zuerst', body: 'Orientierung auf der Karte, Details im Sheet – ohne Umweg über Desktop-Workflows.' },
  { icon: 'check', title: 'Kontrolle in Minuten', body: 'Marker setzen, Zustand erfassen, weiter. Feldtempo statt Formular-Marathon.' },
  { icon: 'export', title: 'Export statt Parallelwelt', body: 'Daten gehen als Excel oder GeoPackage zurück in euer Kataster bzw. QGIS – SoR bleibt bei euch.' },
] as const;

const steps = [
  { n: '1', title: 'Import', body: 'Bäume aus eurem Bestand laden – bereit für den Rundgang.' },
  { n: '2', title: 'Kontrolle', body: 'Auf der Karte arbeiten, Sheet öffnen, Status und Maßnahmen setzen.' },
  { n: '3', title: 'Export', body: 'Als Excel oder GeoPackage zurück in euer Kataster bzw. QGIS.' },
];

const floats = [
  { label: 'Karte + Sheet', text: 'Baum antippen – Details im Sheet' },
  { label: 'Kontrolle', text: 'Status und Maßnahme direkt im Sheet setzen' },
  { label: 'Export', text: 'Excel oder GeoPackage zurück in euer Kataster/QGIS' },
];
---
<BaseLayout
  title="RamosMap – Feld-Baumkontrolle"
  description="Baumkontrolle im Feld – schnell, klar, exportfertig. Die freundliche Feld-App für Baumkontrolle mit Export in euer Kataster."
>
  <Hero
    eyebrow="Feld-Baumkontrolle"
    title="Baumkontrolle im Feld – schnell, klar, exportfertig."
    subtitle="RamosMap ist die freundliche Feld-App für Baumkontrolle: Karte zuerst, Kontrolle in Minuten, Export zurück in euer Kataster."
    floats={floats}
  />
  <StepRow
    eyebrow="So funktioniert’s"
    title="Tagesablauf in drei Schritten"
    intro="RamosMap deckt den Feldteil ab – von der Übernahme eurer Bäume bis zum Export zurück in euer System."
    steps={steps}
  />
  <FeatureCards eyebrow="Warum RamosMap" title="Karte zuerst. Kontrolle in Minuten. Export zurück." cards={[...cards]} />
  <PositionTeaser />
  <CtaBand />
</BaseLayout>
