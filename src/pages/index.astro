---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import StepRow from '../components/StepRow.astro';
import PositionTeaser from '../components/PositionTeaser.astro';
import CtaBand from '../components/CtaBand.astro';
import { FEATURE_CARDS, HOME_DESCRIPTION, HOME_STEPS, HOME_TITLE } from '../config/copy';

const floats = [
  { label: 'Baumkataster', text: 'Eigener Bestand oder Import' },
  { label: 'Baumkontrolle', text: 'Kontrolle und Maßnahmen im Feld' },
  { label: 'Import und Export', text: 'Excel, CSV, GeoPackage; Export Excel und PDF' },
];
---
<BaseLayout title={HOME_TITLE} description={HOME_DESCRIPTION}>
  <Hero
    eyebrow="7 Tage kostenlos testen"
    title='Baumkataster und <span class="hl">Baumkontrolle</span> für Baumpfleger'
    subtitle="RamosMap ist Baumkataster und Baumkontrolle in einer App. Sie können den Bestand direkt in RamosMap führen oder einen bestehenden Bestand importieren und Kontrollen sowie Maßnahmen im Feld erledigen. Für Baumpfleger, Baumkontrolleure sowie Kommunen und Dienstleister."
    floats={floats}
  />
  <FeatureCards
    eyebrow="Funktionen"
    title='Was RamosMap <span class="hl">leistet</span>'
    intro="Baumkataster und Baumkontrolle: Bestand führen oder importieren, Maßnahmen im Feld, Suche, Filter, Export und Team."
    cards={[...FEATURE_CARDS]}
  />
  <StepRow
    eyebrow="So funktioniert’s"
    title="In <span class='hl'>drei</span> Schritten"
    intro="Bestand anlegen oder importieren, Kontrolle und Maßnahmen im Feld, Export und Team."
    steps={[...HOME_STEPS]}
  />
  <PositionTeaser />
  <CtaBand />
</BaseLayout>
