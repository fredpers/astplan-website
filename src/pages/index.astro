---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import StepRow from '../components/StepRow.astro';
import PositionTeaser from '../components/PositionTeaser.astro';
import CtaBand from '../components/CtaBand.astro';
import { FEATURE_CARDS, HOME_DESCRIPTION, HOME_STEPS, HOME_TITLE } from '../config/copy';

const floats = [
  { label: 'Baumbestand', text: 'Bäume auf der Karte' },
  { label: 'Baumkontrolle', text: 'Geführte Kontrolle im Feld' },
  { label: 'Import', text: 'Excel, CSV und GeoPackage' },
];
---
<BaseLayout title={HOME_TITLE} description={HOME_DESCRIPTION}>
  <Hero
    eyebrow="Geschlossene Testphase"
    title='Baumkataster und <span class="hl">Baumkontrolle</span> für Baumpfleger'
    subtitle="RamosMap richtet sich an Baumpfleger, Baumkontrolleure sowie Kommunen und Dienstleister. Die App zeigt den Baumbestand auf der Karte und führt durch die Baumkontrolle. RamosMap befindet sich in einer geschlossenen Testphase und wird nur von Fredrik und eingeladenen Testern genutzt."
    floats={floats}
  />
  <FeatureCards
    eyebrow="Funktionen"
    title='Was RamosMap <span class="hl">leistet</span>'
    intro="RamosMap zeigt den Baumbestand auf der Karte und führt durch die Baumkontrolle."
    cards={[...FEATURE_CARDS]}
  />
  <StepRow
    eyebrow="So funktioniert’s"
    title="In <span class='hl'>drei</span> Schritten"
    intro="Import, Kontrolle im Feld, Bestand im Team aktuell halten."
    steps={[...HOME_STEPS]}
  />
  <PositionTeaser />
  <CtaBand />
</BaseLayout>
