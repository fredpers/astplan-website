---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCards from '../components/FeatureCards.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import { FEATURE_CARDS } from '../config/copy';

const loop = ['Import', 'Kontrolle', 'Bestand'];
---
<BaseLayout
  title="Produkt – RamosMap für Baumkataster und Baumkontrolle"
  description="RamosMap zeigt den Baumbestand auf der Karte und führt durch die Baumkontrolle. Import aus Excel, CSV und GeoPackage. Offline-Karten für Bayern und NRW."
>
  <PageHero
    eyebrow="Produkt"
    title="Baumbestand auf der Karte, geführte <span class='hl'>Baumkontrolle</span>"
    lead="RamosMap zeigt den Baumbestand auf der Karte und führt durch die Baumkontrolle. Import aus Excel, CSV und GeoPackage. RamosMap befindet sich in einer geschlossenen Testphase."
  >
    <ol class="loop" aria-label="Ablauf">
      {loop.map((l, i) => (<li><span class="n">{i + 1}</span>{l}</li>))}
    </ol>
  </PageHero>

  <FeatureCards
    eyebrow="Funktionen"
    title='Was RamosMap <span class="hl">leistet</span>'
    cards={[...FEATURE_CARDS]}
  />

  <CtaBand />
</BaseLayout>
<style>
  .loop { list-style: none; padding: 0; margin: var(--rm-space-10) auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--rm-space-3); }
  .loop li {
    display: inline-flex; align-items: center; gap: var(--rm-space-2);
    padding: 6px 16px 6px 6px; border-radius: var(--rm-radius-pill);
    border: 1px solid var(--site-line-strong); background: var(--site-glass);
    font: 500 15px/1 var(--rm-font-ui); color: var(--rm-text-primary);
  }
  .loop .n { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--site-pill-bg); color: var(--rm-brand-text); font: 600 12px/1 var(--rm-font-mono); }
</style>
