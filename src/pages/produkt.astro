---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCards from '../components/FeatureCards.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import { FEATURE_CARDS } from '../config/copy';

const loop = ['Bestand oder Import', 'Kontrolle und Maßnahmen', 'Export und Team'];
---
<BaseLayout
  title="Produkt – RamosMap für Baumkataster und Baumkontrolle"
  description="RamosMap ist webbasierte Software im Abo für Baumkataster und Baumkontrolle. Bestand führen oder importieren, Maßnahmen im Feld, 7 Tage testen."
>
  <PageHero
    eyebrow="Produkt"
    title="Baumkataster und geführte <span class='hl'>Baumkontrolle</span>"
    lead="RamosMap ist Baumkataster und Baumkontrolle in einer App. Sie können den Bestand direkt in RamosMap führen oder einen bestehenden Bestand importieren und Kontrollen sowie Maßnahmen im Feld erledigen."
  >
    <ol class="loop" aria-label="Ablauf">
      {loop.map((l, i) => (<li><span class="n">{i + 1}</span>{l}</li>))}
    </ol>
  </PageHero>

  <section class="section sold-wrap">
    <div class="container">
      <div class="card sold-card">
        <h2>Was Sie erwerben</h2>
        <p>
          RamosMap ist webbasierte Software im Abo (SaaS) für Baumkontrolle und Baumkataster.
          Das Abonnement ist monatlich oder jährlich buchbar. Sie können RamosMap 7 Tage testen.
          Die App richtet sich an Baumpfleger, Baumkontrolleure, Kommunen und Dienstleister.
          Die aktuellen Preise stehen auf der <a href="/preise">Preisseite</a>.
        </p>
      </div>
    </div>
  </section>

  <FeatureCards
    eyebrow="Funktionen"
    title='Was RamosMap <span class="hl">leistet</span>'
    intro="Funktionen für Baumkataster und Baumkontrolle, von Import bis Team."
    cards={[...FEATURE_CARDS]}
  />

  <CtaBand />
</BaseLayout>
<style>
  .loop { list-style: none; padding: 0; margin: var(--rm-space-10) auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--rm-space-3); }
  .loop li {
    display: inline-flex; align-items: center; gap: var(--rm-space-2);
    padding: 6px 16px 6px 6px; border-radius: var(--rm-radius-pill);
    border: 1px solid var(--site-line-strong); background: var(--site-glass);
    font: 500 15px/1 var(--rm-font-ui); color: var(--rm-text-primary);
  }
  .loop .n { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--site-pill-bg); color: var(--rm-brand-text); font: 600 12px/1 var(--rm-font-mono); }
  .sold-wrap { padding-top: var(--site-section-y); padding-bottom: 0; }
  .sold-card { max-width: 720px; margin: 0 auto; padding: var(--rm-space-10); }
  .sold-card h2 { margin: 0 0 var(--rm-space-4); font: var(--rm-type-h3); font-size: 28px; }
  .sold-card p { margin: 0; color: var(--rm-text-secondary); }
  .sold-card a { color: var(--rm-link); }
</style>
