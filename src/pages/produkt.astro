---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const sections = [
  {
    title: 'Karte + Sheet',
    body: 'Die Karte ist der Einstieg. Tippt einen Baum an — das Sheet zeigt die relevanten Felder, ohne die Orientierung zu verlieren.',
  },
  {
    title: 'Marker',
    body: 'Neue oder geänderte Punkte direkt im Feld setzen. Klar sichtbar, filterbar, exportierbar.',
  },
  {
    title: 'Filter',
    body: 'Nach Status, Maßnahme oder Gebiet filtern — der Rundgang bleibt übersichtlich.',
  },
  {
    title: 'Offline / Sync',
    body: 'Im Gelände oft kein Netz: lokal weiterarbeiten und später synchronisieren.',
  },
  {
    title: 'Export',
    body: 'Kontrolle abgeschlossen? Excel-Export — und zurück in euer Kataster als System of Record.',
  },
];
---

<BaseLayout
  title="Produkt"
  description="Der Feld-Loop: Import → Kontrolle → Ausführung → Excel. RamosMap als Feldschicht für Baumkontrolle."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Produkt</span>
      <h1>Der Feld-Loop: Import → Kontrolle → Ausführung → Excel</h1>
      <p class="lead">
        RamosMap deckt den Feldteil ab — von der Übernahme eurer Bäume bis zum Export zurück in euer System.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container stack">
      {
        sections.map((s) => (
          <article class="card block">
            <h2>{s.title}</h2>
            <p>{s.body}</p>
          </article>
        ))
      }
      <article class="card block nicht">
        <h2>Nicht-Ziele</h2>
        <p>
          RamosMap ersetzt kein vollständiges Baumkataster und keine Desktop-GIS-Suite. Wir sind die
          Feldschicht — euer Kataster bleibt SoR.
        </p>
      </article>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: 14px;
    max-width: 720px;
  }
  .block h2 {
    font-size: 22px;
    margin-bottom: 8px;
  }
  .block p {
    margin: 0;
  }
  .nicht {
    border-style: dashed;
  }
</style>
