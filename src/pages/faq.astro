---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';

const items = [
  {
    q: 'Ersetzt AstPlan unser Baumkataster?',
    a: 'Nein. AstPlan ist die <strong>Feldschicht</strong>. Euer Kataster bzw. GIS-System bleibt System of Record. Wir importieren, kontrollieren im Feld und exportieren zurück.',
  },
  {
    q: 'Brauche ich nur den Browser?',
    a: 'Ja für den Einstieg: AstPlan läuft als Web-App im Browser auf Handy und Tablet. Kein App-Store-Zwang für den Feldalltag.',
  },
  {
    q: 'Funktioniert das offline?',
    a: 'Ja — im Gelände oft ohne Netz. Ihr arbeitet lokal weiter und synchronisiert, sobald wieder Verbindung besteht.',
  },
  {
    q: 'Wie funktionieren Konten / Zugang?',
    a: 'Aktuell: App öffnen und loslegen. Registrierung und Team-/Rollen-Details folgen mit dem Produktausbau.',
  },
  {
    q: 'Welche Exporte gibt es?',
    a: 'Excel-Export der Kontrolle — gedacht für den Rückweg in euer Kataster bzw. GIS-System. Weitere Formate nach Bedarf.',
  },
  {
    q: 'Und QGIS / Desktop-GIS?',
    a: 'AstPlan ersetzt kein Desktop-GIS. Wenn ihr QGIS oder vergleichbare Tools für Analyse und Planung nutzt, bleibt das so — wir sind für den Feld-Loop da.',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Häufige Fragen zu AstPlan: Baumkataster, Browser, Offline, Konten, Exporte, QGIS."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h1>Häufige Fragen</h1>
      <p class="lead">Kurz und klar — ohne Marketingnebel.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <FaqAccordion items={items} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
