---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';

const items = [
  { q: 'Ersetzt RamosMap unser Baumkataster?', a: 'Nein. RamosMap ergänzt Ihr Baumkataster – und ersetzt es nicht. Ihr Kataster bleibt die maßgebliche Datenquelle. Wir importieren, kontrollieren im Feld und exportieren zurück.' },
  { q: 'Reicht ein Browser?', a: 'Ja. RamosMap läuft als Web-App im Browser auf Smartphone und Tablet – ohne Installation aus dem App Store.' },
  { q: 'Wie bekomme ich Zugang?', a: 'Aktuell: App öffnen und loslegen. Team- und Rollenverwaltung folgt.' },
  { q: 'Welche Exporte gibt es?', a: 'Excel oder GeoPackage zurück in Ihr Kataster/QGIS.' },
  { q: 'Und unser Desktop-GIS (z. B. QGIS)?', a: 'RamosMap ersetzt kein Desktop-GIS. Wenn Sie QGIS oder vergleichbare Tools für Analyse und Planung nutzen, bleibt das so.' },
  { q: 'Datenschutz und Hosting?', a: '<!-- TODO Fredrik -->Antwort folgt.' },
  { q: 'Was kostet RamosMap?', a: '<!-- TODO Fredrik -->Antwort folgt.' },
  { q: 'Welche Formate werden unterstützt?', a: '<!-- TODO Fredrik -->Antwort folgt.' },
  { q: 'Wie erreiche ich den Support?', a: '<!-- TODO Fredrik -->Antwort folgt.' },
];
---
<BaseLayout title="FAQ" description="Häufige Fragen zu RamosMap: Baumkataster, Browser, Konten, Exporte, QGIS.">
  <PageHero eyebrow="FAQ" title="Häufige Fragen" lead="Kurze Antworten auf häufige Fragen." />
  <section class="body-wrap">
    <div class="container"><FaqAccordion items={items} /></div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
</style>
