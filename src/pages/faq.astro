---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';

const items = [
  { q: 'Ersetzt RamosMap unser Baumkataster?', a: 'Nein. RamosMap ist die <strong>Feldschicht</strong>. Euer Kataster bzw. GIS-System bleibt System of Record. Wir importieren, kontrollieren im Feld und exportieren zurück.' },
  { q: 'Brauche ich nur den Browser?', a: 'Ja für den Einstieg: RamosMap läuft als Web-App im Browser auf Handy und Tablet. Kein App-Store-Zwang für den Feldalltag.' },
  { q: 'Wie funktionieren Konten / Zugang?', a: 'Aktuell: App öffnen und loslegen. Registrierung und Team-/Rollen-Details folgen mit dem Produktausbau.' },
  { q: 'Welche Exporte gibt es?', a: 'Excel-Export der Kontrolle und GeoPackage-Export für QGIS – gedacht für den Rückweg in euer Kataster bzw. GIS-System.' },
  { q: 'Und QGIS / Desktop-GIS?', a: 'RamosMap ersetzt kein Desktop-GIS. Wenn ihr QGIS oder vergleichbare Tools für Analyse und Planung nutzt, bleibt das so – wir sind für den Feld-Loop da.' },
];
---
<BaseLayout title="FAQ" description="Häufige Fragen zu RamosMap: Baumkataster, Browser, Konten, Exporte, QGIS.">
  <PageHero eyebrow="FAQ" title="Häufige Fragen" lead="Kurz und klar – ohne Marketingnebel." />
  <section class="body-wrap">
    <div class="container"><FaqAccordion items={items} /></div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
</style>
