---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import { FAQ_ITEMS, faqJsonLd } from '../config/copy';

const jsonLd = faqJsonLd(FAQ_ITEMS);
---
<BaseLayout
  title="FAQ – RamosMap"
  description="Antworten zu Testphase, Importformaten, Offline-Karten, Datenschutz, Preisen und Teamarbeit bei RamosMap."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <PageHero
    eyebrow="FAQ"
    title="Häufige Fragen zu RamosMap"
    lead="Antworten zu Testphase, Formaten, Offline-Karten, Datenschutz, Preisen und Teamarbeit."
  />
  <section class="body-wrap">
    <div class="container"><FaqAccordion items={FAQ_ITEMS} /></div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
</style>
