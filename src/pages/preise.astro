---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Preise" description="Preise folgen in Kürze.">
  <PageHero
    eyebrow="Preise"
    title="Preise folgen in Kürze."
    lead="Transparente Pakete erscheinen hier, sobald die Preisgestaltung freigegeben ist."
  />
  <CtaBand
    title="Bereit für die nächste <span class='hl'>Baumkontrolle</span>?"
    body="App öffnen und starten – Preise und Registrierung folgen, sobald sie freigegeben sind."
  />
</BaseLayout>
