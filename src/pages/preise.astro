---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import CtaButtons from '../components/CtaButtons.astro';
---
<BaseLayout title="Preise" description="Preise für RamosMap – kommt bald. Bis dahin App öffnen und ausprobieren.">
  <PageHero
    eyebrow="Preise"
    title="Preise – kommt bald"
    lead="Transparente Pakete folgen. Wir nennen hier keine erfundenen Euro-Beträge – bis die Preisgestaltung freigegeben ist, könnt ihr die App schon öffnen und testen."
  />
  <section class="price-wrap">
    <div class="container">
      <article class="card plan">
        <span class="ribbon">Platzhalter</span>
        <h2 class="plan-title">Pakete in Vorbereitung</h2>
        <p class="plan-body">Sobald Modelle und Konditionen stehen, erscheinen sie auf dieser Seite.</p>
        <div class="plan-cta"><CtaButtons align="center" /></div>
      </article>
    </div>
  </section>
  <CtaBand
    title="Interesse an Zugang?"
    body="App öffnen und starten – Preise und Registrierung folgen, sobald sie freigegeben sind."
  />
</BaseLayout>
<style>
  .price-wrap { padding: var(--site-section-y) 0 0; }
  .plan { max-width: 560px; margin: 0 auto; text-align: center; padding: var(--rm-space-14) var(--rm-space-8) var(--rm-space-10); border-color: var(--rm-purple-200); }
  .ribbon {
    position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%);
    padding: 5px 14px; border-radius: var(--rm-radius-pill);
    background: var(--rm-brand-muted); color: var(--rm-brand-strong);
    font: var(--rm-type-overline); letter-spacing: var(--rm-type-overline-tracking); text-transform: uppercase;
  }
  .plan-title { font: var(--rm-type-h2); letter-spacing: var(--rm-type-h2-tracking); margin-bottom: var(--rm-space-3); }
  .plan-body { color: var(--rm-text-muted); margin-bottom: var(--rm-space-8); }
</style>
