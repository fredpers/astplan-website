---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/CompareTable.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';

const rows = [
  { label: 'Aufgabe', ramosmap: 'Baumkataster und Baumkontrolle, Maßnahmen im Feld', kataster: 'Bestand, Planung und Verwaltung' },
  { label: 'Daten', ramosmap: 'Import Excel, CSV, GeoPackage; Export Excel und PDF', kataster: 'Bestehendes Fachsystem für den Bestand' },
  { label: 'Offline', ramosmap: 'Karten und Luftbilder nur für Bayern und Nordrhein-Westfalen', kataster: 'Abhängig vom jeweiligen System' },
  { label: 'Team', ramosmap: 'Einladungen; Rollen Mitarbeiter und Betrachter', kataster: 'Abhängig vom jeweiligen System' },
  { label: 'Nutzung', ramosmap: 'Als Ihr Baumkataster oder neben einem bestehenden Kataster', kataster: 'Oft führendes Fachsystem' },
];
---
<BaseLayout
  title="Einordnung – RamosMap als Baumkataster oder ergänzend"
  description="RamosMap ist Baumkataster und Baumkontrolle in einer App. Bestand direkt führen oder bestehenden Bestand importieren und Kontrollen sowie Maßnahmen im Feld erledigen."
>
  <PageHero
    eyebrow="Einordnung"
    title="Als Baumkataster oder <span class='hl'>neben</span> Ihrem Kataster"
    lead="RamosMap ist Baumkataster und Baumkontrolle in einer App. Sie können den Bestand direkt in RamosMap führen oder einen bestehenden Bestand importieren und Kontrollen sowie Maßnahmen im Feld erledigen."
  />
  <section class="body-wrap">
    <div class="container">
      <CompareTable rows={rows} />
      <p class="note">
        Kurzfassung: RamosMap kann Ihr Baumkataster sein oder neben einem bestehenden Kataster
        arbeiten. Import aus Excel, CSV und GeoPackage; Export nach Excel und PDF; Offline-Karten
        nur für Bayern und Nordrhein-Westfalen.
      </p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
  .note { margin: var(--rm-space-8) auto 0; font: var(--rm-type-body-sm); max-width: 640px; color: var(--rm-text-secondary); text-align: center; }
</style>
