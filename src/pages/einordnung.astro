---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/CompareTable.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';

const rows = [
  { label: 'Aufgabe', ramosmap: 'Baumbestand auf der Karte, geführte Baumkontrolle', kataster: 'Bestand, Planung und Verwaltung' },
  { label: 'Daten', ramosmap: 'Import aus Excel, CSV und GeoPackage', kataster: 'Führendes System für den Bestand' },
  { label: 'Offline', ramosmap: 'Karten und Luftbilder für Bayern und Nordrhein-Westfalen', kataster: 'Abhängig vom jeweiligen System' },
  { label: 'Team', ramosmap: 'Einladungen ins Team', kataster: 'Abhängig vom jeweiligen System' },
  { label: 'Führendes System?', ramosmap: 'Nein. RamosMap ergänzt Ihr Kataster.', kataster: 'Ja' },
];
---
<BaseLayout
  title="Einordnung – RamosMap ergänzt Ihr Baumkataster"
  description="RamosMap ergänzt Ihr Baumkataster und ersetzt es nicht. Die App dient der Arbeit im Feld; Ihr Kataster bleibt die maßgebliche Datenquelle."
>
  <PageHero
    eyebrow="Einordnung"
    title="RamosMap ergänzt Ihr <span class='hl'>Kataster</span>"
    lead="RamosMap ersetzt Ihr Baumkataster nicht. Ihr Kataster bleibt die maßgebliche Datenquelle."
  />
  <section class="body-wrap">
    <div class="container">
      <CompareTable rows={rows} />
      <p class="note">
        Kurzfassung: Ihr Kataster bleibt die maßgebliche Datenquelle. RamosMap ergänzt es
        um Bestand auf der Karte, geführte Baumkontrolle und Teameinladungen.
      </p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
  .note { margin: var(--rm-space-8) auto 0; font: var(--rm-type-body-sm); max-width: 640px; color: var(--rm-text-secondary); text-align: center; }
</style>
