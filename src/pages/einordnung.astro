---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/CompareTable.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';

const rows = [
  { label: 'Rolle', ramosmap: 'Feld-App für die Baumkontrolle', kataster: 'Baumkataster / GIS' },
  { label: 'Fokus', ramosmap: 'Kontrolle & Ausführung im Gelände', kataster: 'Bestand, Planung, Verwaltung' },
  { label: 'Gerät', ramosmap: 'Handy / Tablet zuerst', kataster: 'Desktop & Fachverfahren' },
  { label: 'Datenfluss', ramosmap: 'Import → Feld → Excel/GeoPackage-Export', kataster: 'Führendes System' },
  { label: 'Führendes System?', ramosmap: 'Nein, Ihr Kataster bleibt maßgeblich', kataster: 'Ja' },
];
---
<BaseLayout
  title="Einordnung"
  description="RamosMap ergänzt Ihr Baumkataster – und ersetzt es nicht. Ergänzung zu bestehenden Baumkataster- und GIS-Systemen."
>
  <PageHero
    eyebrow="Einordnung"
    title="RamosMap ergänzt Ihr <span class='hl'>Baumkataster</span> – und ersetzt es nicht."
    lead="Wir ergänzen bestehende Baumkataster: schnell im Feld, sauber zurück."
  />
  <section class="body-wrap">
    <div class="container">
      <CompareTable rows={rows} />
      <p class="note">
        Kurzfassung: Ihr Kataster bleibt die maßgebliche Datenquelle. RamosMap liegt dazwischen –
        Import, Kontrolle im Feld, Export zurück.
      </p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
  .note { margin: var(--rm-space-8) auto 0; font: var(--rm-type-body-sm); max-width: 640px; color: var(--rm-text-secondary); text-align: center; }
</style>
