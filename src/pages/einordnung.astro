---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/CompareTable.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';

const rows = [
  { label: 'Aufgabe', ramosmap: 'Baumbestand auf der Karte, geführte Baumkontrolle, Maßnahmen im Feld', kataster: 'Bestand, Planung und Verwaltung' },
  { label: 'Daten', ramosmap: 'Import aus Excel, CSV und GeoPackage; eigener Bestand in RamosMap', kataster: 'Bestand im jeweiligen System' },
  { label: 'Offline', ramosmap: 'Karten und Luftbilder für Bayern und Nordrhein-Westfalen', kataster: 'Abhängig vom jeweiligen System' },
  { label: 'Team', ramosmap: 'Einladungen ins Team', kataster: 'Abhängig vom jeweiligen System' },
  { label: 'Einsatzweise', ramosmap: 'Als Baumkataster oder neben bestehendem Kataster', kataster: 'Führendes System für Bestand und Planung' },
];
---
<BaseLayout
  title="Einordnung – RamosMap als Baumkataster oder daneben"
  description="RamosMap dient der Baumkontrolle und dem Baumkataster. Sie können RamosMap als Ihr Baumkataster nutzen oder einen bestehenden Bestand importieren und Kontrollen sowie Maßnahmen im Feld durchführen."
>
  <PageHero
    eyebrow="Einordnung"
    title="Als Kataster oder <span class='hl'>daneben</span>"
    lead="RamosMap kann Ihr Baumkataster sein. Alternativ importieren Sie einen bestehenden Bestand und führen Kontrollen sowie Maßnahmen im Feld durch."
  />
  <section class="body-wrap">
    <div class="container">
      <CompareTable rows={rows} />
      <p class="note">
        Kurzfassung: RamosMap kann Ihr Baumkataster sein oder neben einem bestehenden Kataster laufen.
        Sie importieren den Bestand und führen Kontrollen sowie Maßnahmen im Feld durch.
      </p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .body-wrap { padding: var(--site-section-y) 0 0; }
  .note { margin: var(--rm-space-8) auto 0; font: var(--rm-type-body-sm); max-width: 640px; color: var(--rm-text-secondary); text-align: center; }
</style>
